{
 "edit-min": "<div class=\"card form\" data-form=\"edit\" data-id=\"fx-item\">\n      <label class=\"field\"><span>Название</span><input type=\"text\" id=\"e-name\" value=\"Пункт минимума\"></label>\n      <label class=\"field\"><span>Подпись</span><input type=\"text\" id=\"e-note\" value=\"подпись\" placeholder=\"необязательная строка под названием\"></label>\n      \n      <div class=\"pair\">\n        <label class=\"field\"><span>Значение</span><input class=\"num\" type=\"text\" inputmode=\"decimal\" id=\"e-value\" value=\"10\"></label>\n        <label class=\"field\"><span>Единица</span><input type=\"text\" id=\"e-unit\" value=\"мин\"></label>\n      </div>\n      \n    <label class=\"field\"><span>Блок</span>\n      <select id=\"e-group\" data-act=\"group-pick\"><option value=\"\">— без блока</option><option value=\"Утро\" selected=\"\">Утро</option><option value=\"\">+ Новый блок…</option></select>\n    </label>\n    \n      <div class=\"btns dfoot\"><button class=\"btn quiet\" data-act=\"item-detail\" data-id=\"fx-item\">Формула и лестница ›</button></div>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"edit-save\" data-id=\"fx-item\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"edit-cancel\">Отмена</button>\n      </div>\n    </div>",
 "edit-habit": "<div class=\"card form\" data-form=\"edit\" data-id=\"fx-habit\">\n      <label class=\"field\"><span>Название</span><input type=\"text\" id=\"e-name\" value=\"Привычка\"></label>\n      <label class=\"field\"><span>Подпись</span><input type=\"text\" id=\"e-note\" value=\"\" placeholder=\"необязательная строка под названием\"></label>\n      \n      <div class=\"field inline norm\">\n        <span>Норма в неделю: <b>7</b></span>\n        <span class=\"btns\">\n          <button type=\"button\" class=\"btn icon quiet\" data-act=\"norm-dec\" data-id=\"fx-habit\" aria-label=\"уменьшить норму\">−</button>\n          <button type=\"button\" class=\"btn icon quiet\" data-act=\"norm-inc\" data-id=\"fx-habit\" disabled=\"\" aria-label=\"увеличить норму\">+</button>\n        </span>\n      </div>\n      \n    <label class=\"field\"><span>Блок</span>\n      <select id=\"e-group\" data-act=\"group-pick\"><option value=\"\" selected=\"\">— без блока</option><option value=\"Утро\">Утро</option><option value=\"\">+ Новый блок…</option></select>\n    </label>\n    <div class=\"btns dfoot\"><button class=\"btn quiet\" data-act=\"item-detail\" data-id=\"fx-habit\">Формула и лестница ›</button></div>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"edit-save\" data-id=\"fx-habit\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"edit-cancel\">Отмена</button>\n      </div>\n    </div>",
 "edit-param": "<div class=\"card form\" data-form=\"edit\" data-id=\"fx-param\">\n      <label class=\"field\"><span>Название</span><input type=\"text\" id=\"e-name\" value=\"Порог\"></label>\n      <label class=\"field\"><span>Подпись</span><input type=\"text\" id=\"e-note\" value=\"\" placeholder=\"необязательная строка под названием\"></label>\n      \n      <p class=\"muted\">Вид: время</p>\n      <label class=\"field\"><span>Порог</span><input id=\"e-ptime\" type=\"time\" value=\"00:00\"></label>\n      <label class=\"field\"><span>Шаг (со знаком)</span><input class=\"num\" type=\"text\" inputmode=\"decimal\" id=\"e-pstep\" value=\"-15\"></label>\n      \n    <label class=\"field\"><span>Блок</span>\n      <select id=\"e-group\" data-act=\"group-pick\"><option value=\"\" selected=\"\">— без блока</option><option value=\"Утро\">Утро</option><option value=\"\">+ Новый блок…</option></select>\n    </label>\n    \n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"edit-save\" data-id=\"fx-param\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"edit-cancel\">Отмена</button>\n      </div>\n    </div>",
 "add-min": "<div class=\"card form\" data-form=\"add\">\n      \n      <label class=\"field\"><span>Название</span><input type=\"text\" id=\"f-name\" placeholder=\"Например: чтение\"></label>\n      <label class=\"field\"><span>Подпись</span><input type=\"text\" id=\"f-note\" placeholder=\"необязательная строка под названием\"></label>\n      <div class=\"pair\">\n        <label class=\"field\"><span>Значение</span><input class=\"num\" type=\"text\" inputmode=\"decimal\" id=\"f-value\" placeholder=\"10\"></label>\n        <label class=\"field\"><span>Единица</span><input type=\"text\" id=\"f-unit\" placeholder=\"мин\"></label>\n      </div>\n      \n    <label class=\"field\"><span>Блок</span>\n      <select id=\"f-group\" data-act=\"group-pick\"><option value=\"\" selected=\"\">— без блока</option><option value=\"Утро\">Утро</option><option value=\"\">+ Новый блок…</option></select>\n    </label>\n    \n      <label class=\"field\"><span>Тип</span>\n        <select id=\"f-type\" data-act=\"add-type\">\n          <option value=\"daily\" selected=\"\">ежедневный чекбокс</option>\n          <option value=\"weekly\">недельный счётчик с целью</option>\n        </select>\n      </label>\n      \n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"add-save\">Добавить</button>\n        <button class=\"btn quiet\" data-act=\"add-cancel\">Отмена</button>\n      </div>\n    </div>",
 "add-habit": "<div class=\"card form\" data-form=\"add\">\n      \n      <label class=\"field\"><span>Название</span><input type=\"text\" id=\"f-name\" placeholder=\"Например: чтение\"></label>\n      <label class=\"field\"><span>Подпись</span><input type=\"text\" id=\"f-note\" placeholder=\"необязательная строка под названием\"></label>\n      <label class=\"field\"><span>Тип</span>\n        <select id=\"f-type\" data-act=\"add-type\">\n          <option value=\"daily\" selected=\"\">привычка (ежедневная)</option>\n          <option value=\"param\">параметр (порог недели)</option>\n        </select>\n      </label>\n      \n      \n    <label class=\"field\"><span>Блок</span>\n      <select id=\"f-group\" data-act=\"group-pick\"><option value=\"\" selected=\"\">— без блока</option><option value=\"Утро\">Утро</option><option value=\"\">+ Новый блок…</option></select>\n    </label>\n    \n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"add-save\">Добавить</button>\n        <button class=\"btn quiet\" data-act=\"add-cancel\">Отмена</button>\n      </div>\n    </div>",
 "group-edit": "<div class=\"card form\" data-form=\"group-edit\" data-id=\"Утро\">\n          <label class=\"field\"><span>Название</span><input type=\"text\" id=\"g-name\" value=\"Утро\"></label>\n          <div class=\"btns\">\n            <button class=\"btn primary\" data-act=\"group-save\" data-name=\"Утро\">Сохранить</button>\n            <button class=\"btn quiet\" data-act=\"group-cancel\">Отмена</button>\n            <button class=\"btn quiet\" data-act=\"group-del\" data-name=\"Утро\">Удалить</button>\n          </div>\n        </div>",
 "group-add": "<div class=\"card form\" data-form=\"group-add\">\n        <label class=\"field\"><span>Название блока</span><input type=\"text\" id=\"g-add\" placeholder=\"Например: Вечер\"></label>\n        <div class=\"btns\">\n          <button class=\"btn primary\" data-act=\"group-add-save\">Добавить</button>\n          <button class=\"btn quiet\" data-act=\"group-add-cancel\">Отмена</button>\n        </div>\n      </div>",
 "ex-edit": "<div class=\"card form\" data-form=\"ex-edit\" data-id=\"fx-ex\">\n          <label class=\"field\"><span>Название</span><input type=\"text\" id=\"x-name\" value=\"Жим\"></label>\n          <label class=\"field\"><span>Единица</span><input type=\"text\" id=\"x-unit\" value=\"кг\" placeholder=\"кг, повт.\"></label>\n          <div class=\"btns\">\n            <button class=\"btn primary\" data-act=\"ex-save\" data-id=\"fx-ex\">Сохранить</button>\n            <button class=\"btn quiet\" data-act=\"ex-cancel\">Отмена</button>\n          </div>\n        </div>",
 "ex-add": "<div class=\"card form\" data-form=\"ex-add\">\n        <label class=\"field\"><span>Название</span><input type=\"text\" id=\"x-add-name\" placeholder=\"Например: Жим лёжа\"></label>\n        <label class=\"field\"><span>Единица</span><input type=\"text\" id=\"x-add-unit\" placeholder=\"кг, повт.\"></label>\n        <label class=\"field\"><span>Рабочая нагрузка</span><input type=\"text\" id=\"x-add-value\" inputmode=\"decimal\" placeholder=\"необязательно\"></label>\n        <div class=\"btns\">\n          <button class=\"btn primary\" data-act=\"ex-add-save\">Добавить</button>\n          <button class=\"btn quiet\" data-act=\"ex-add-cancel\">Отмена</button>\n        </div>\n      </div>",
 "note-add": "<div class=\"card form\" data-form=\"note\" data-id=\"new\">\n      <label class=\"field\"><span>Заметка</span>\n        <textarea id=\"n-text\" rows=\"6\"></textarea></label>\n      \n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"note-save\" data-id=\"new\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"note-cancel\">Отмена</button>\n        \n      </div>\n    </div>",
 "quote-add": "<div class=\"card form\" data-form=\"note\" data-id=\"new\">\n      <label class=\"field\"><span>Выписка</span>\n        <textarea id=\"n-text\" rows=\"6\"></textarea></label>\n      <label class=\"field\"><span>Источник</span>\n        <input type=\"text\" id=\"n-source\" value=\"\" placeholder=\"необязательно\"></label>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"note-save\" data-id=\"new\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"note-cancel\">Отмена</button>\n        \n      </div>\n    </div>",
 "formula-build": "<div class=\"card form formula\" data-form=\"formula\" data-id=\"fx-item\">\n      <label class=\"field\"><span>Режим</span>\n        <select id=\"fx-mode\" data-act=\"formula-mode\"><option value=\"build\" selected=\"\">Завожу привычку</option><option value=\"break\">Избавляюсь от привычки</option></select></label><p class=\"overline\">Очевидно</p>\n      <label class=\"field\"><span>Якорь</span><input type=\"text\" id=\"fx-anchor\" value=\"после зарядки\"></label>\n      <p class=\"hint\">То, что уже происходит каждый день само. „После того как поставлю телефон на зарядку“ — якорь. „Вечером“ — не якорь.</p>\n      <label class=\"field\"><span>Время и место</span><input type=\"text\" id=\"fx-when\" value=\"\"></label>\n      <p class=\"hint\">Одно время, одно место. Чем конкретнее, тем меньше решений вечером.</p><p class=\"overline\">Привлекательно</p>\n      <label class=\"field\"><span>Сразу после</span><input type=\"text\" id=\"fx-pair\" value=\"\"></label>\n      <p class=\"hint\">Что приятного идёт следом, чтобы вечер не был про запрет. Не еда и не покупка.</p>\n      <label class=\"field\"><span>Кем становлюсь</span><input type=\"text\" id=\"fx-identity\" value=\"\"></label>\n      <p class=\"hint\">От лица человека, а не результата. Не „хочу высыпаться“, а „я человек, который ложится вовремя“. Каждая отметка — голос за это.</p><p class=\"overline\">Легко</p>\n      <label class=\"field\"><span>Версия на 2 минуты</span><input type=\"text\" id=\"fx-twoMin\" value=\"\"></label>\n      <p class=\"hint\">Урежь до того, что стыдно не сделать. Не „уснуть в 23:30“, а „в 23:30 быть в кровати“. Уснуть — не твоё дело, лечь — твоё.</p>\n      <label class=\"field\"><span>Что уберу с пути</span><input type=\"text\" id=\"fx-friction\" value=\"\"></label>\n      <p class=\"hint\">Одно физическое препятствие. Зарядка в коридоре работает сильнее любого намерения.</p><p class=\"overline\">Приятно</p>\n      <label class=\"field\"><span>Что подтвердит день</span><input type=\"text\" id=\"fx-proof\" value=\"\"></label>\n      <p class=\"hint\">Одно наблюдаемое действие, не ощущение. Отметка в приложении уже считается — допиши, если нужно ещё.</p>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"formula-save\" data-id=\"fx-item\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"formula-cancel\">Отмена</button>\n      </div>\n    </div>",
 "formula-break": "<div class=\"card form formula\" data-form=\"formula\" data-id=\"fx-item\">\n      <label class=\"field\"><span>Режим</span>\n        <select id=\"fx-mode\" data-act=\"formula-mode\"><option value=\"build\">Завожу привычку</option><option value=\"break\" selected=\"\">Избавляюсь от привычки</option></select></label><p class=\"overline\">Невидимо</p>\n      <label class=\"field\"><span>Что перехватываю</span><input type=\"text\" id=\"fx-anchor\" value=\"после зарядки\"></label>\n      <p class=\"hint\">Назови момент, а не состояние. „Когда нервничаю“ — не момент. „Когда рука пошла ко рту“ — момент, его можно заметить.</p>\n      <label class=\"field\"><span>Время и место</span><input type=\"text\" id=\"fx-when\" value=\"\"></label>\n      <p class=\"hint\">Где и когда это обычно случается. Знаешь опасную зону — можешь менять обстановку именно там.</p><p class=\"overline\">Непривлекательно</p>\n      <label class=\"field\"><span>Что я на самом деле получаю</span><input type=\"text\" id=\"fx-pair\" value=\"\"></label>\n      <p class=\"hint\">Не абстрактный вред, а конкретное последствие с прошлой недели. Награда приходит сразу, расплата потом — записанная цена подтягивает расплату ближе.</p>\n      <label class=\"field\"><span>Кем становлюсь</span><input type=\"text\" id=\"fx-identity\" value=\"\"></label>\n      <p class=\"hint\">„Я бросаю“ — человек, который борется. „Я не грызу“ — человек, который не грызёт. Разные предложения, разный результат.</p><p class=\"overline\">Трудно</p>\n      <label class=\"field\"><span>Действие-замена</span><input type=\"text\" id=\"fx-twoMin\" value=\"\"></label>\n      <p class=\"hint\">За это будет ставиться отметка. Короткое, физическое, выполнимое прямо в момент срыва. Не „взять себя в руки“, а конкретное движение.</p>\n      <label class=\"field\"><span>Что поставлю на пути</span><input type=\"text\" id=\"fx-friction\" value=\"\"></label>\n      <p class=\"hint\">Физическая преграда, не намерение. Каждая лишняя секунда между желанием и действием — секунда, чтобы опомниться. Преграда должна работать, когда ты устал.</p><p class=\"overline\">Приятно</p>\n      <label class=\"field\"><span>Что подтвердит день</span><input type=\"text\" id=\"fx-proof\" value=\"\"></label>\n      <p class=\"hint\">Наблюдаемый результат, а не „не сорвался“. Целая кожа. Пустой список желаний. Баланс не изменился.</p>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"formula-save\" data-id=\"fx-item\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"formula-cancel\">Отмена</button>\n      </div>\n    </div>",
 "ladder": "<div class=\"card form ladder-form\" data-form=\"ladder\" data-id=\"fx-item\">\n      \n      \n      <label class=\"field\"><span>Ступени — по одной на строку</span>\n        <textarea id=\"fx-steps\" rows=\"6\">В 23:30 быть в кровати. Телефон — на зарядке вне спальни.\n+ 10 минут без экрана до отбоя.\n+ отбой на 15 минут раньше.\n+ вечерний ритуал 10 минут: свет приглушён, душ или растяжка.\n+ подъём в одно время, включая выходные.</textarea></label>\n      <div class=\"btns\">\n        <button class=\"btn primary\" data-act=\"ladder-save\" data-id=\"fx-item\">Сохранить</button>\n        <button class=\"btn quiet\" data-act=\"ladder-cancel\">Отмена</button>\n        \n      </div>\n    </div>"
}
